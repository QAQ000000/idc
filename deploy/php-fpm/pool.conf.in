; Include in a dedicated PHP 8.4 FPM master configuration.
[@NAME@]
user = @USER@
group = @GROUP@
listen = @FPM_SOCKET@
listen.owner = @USER@
listen.group = @WEB_GROUP@
listen.mode = 0660
pm = dynamic
pm.max_children = 4
pm.start_servers = 1
pm.min_spare_servers = 1
pm.max_spare_servers = 2
pm.max_requests = 500
clear_env = yes
env[APP_ENVIRONMENT_PATH] = @ENV_DIR@
env[APP_CONFIG_CACHE] = @CONFIG_CACHE@
env[LARAVEL_STORAGE_PATH] = @STORAGE@
catch_workers_output = yes
decorate_workers_output = no
security.limit_extensions = .php
php_admin_flag[display_errors] = off
php_admin_flag[log_errors] = on
