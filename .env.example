APP_NAME=JianYun
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jianyun
DB_USERNAME=root
DB_PASSWORD=

# 历史旧站数据库 (仅数据割接期使用; 凭据填写真实值, 严禁提交)
LEGACY_DB_DATABASE=idc2
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Comma-separated exact origins; leave empty for same-origin requests only.
CORS_ALLOWED_ORIGINS=

# Exact proxy IPs or CIDRs, comma-separated. Empty means trust no forwarded headers.
TRUSTED_PROXIES=
