APP_NAME=JianYun
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jianyun
DB_USERNAME=root
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Comma-separated exact origins; leave empty for same-origin requests only.
CORS_ALLOWED_ORIGINS=

# Exact proxy IPs or CIDRs, comma-separated. Empty means trust no forwarded headers.
TRUSTED_PROXIES=

# Optional VNC direct connection: approved cloud WS hosts, distinct from the financial API host.
# Exact lowercase host:port. Empty disables console authorization; production requires WSS/public IP.
CONSOLE_TARGETS=

# Explicit local product IDs, comma-separated (max50). Empty disables scheduled refresh.
# Separate background process, at most2 products/batch, >=10 minutes between attempts.
PRODUCT_REFRESH_IDS=
