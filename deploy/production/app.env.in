APP_NAME=JianYun
APP_ENV=production
APP_DEBUG=false
APP_KEY=REPLACE_WITH_NEW_ENVIRONMENT_KEY
APP_URL=https://shop.example.com

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jianyun_prod
DB_USERNAME=jianyun_prod
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
REDIS_DB=0

# Same-origin site. Trust forwarded headers only when a real edge is configured.
CORS_ALLOWED_ORIGINS=
TRUSTED_PROXIES=
# Approved independent cloud console hostname:443; empty disables VNC.
CONSOLE_TARGETS=
