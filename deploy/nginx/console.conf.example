# Include inside the existing HTTPS site server; keep the Vue fallback and PHP API config.
location ^~ /console/ws/ {
    proxy_pass http://127.0.0.1:18213;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header Origin $http_origin;
    proxy_set_header Sec-WebSocket-Protocol $http_sec_websocket_protocol;
    proxy_read_timeout 920s;
    proxy_send_timeout 30s;
    proxy_buffering off;
    # Request paths contain one-use tickets. Never log them or request headers.
    access_log off;
    error_log /dev/null;
}
