APP_NAME=JianYun
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jianyun
DB_USERNAME=root
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Comma-separated exact origins; leave empty for same-origin requests only.
CORS_ALLOWED_ORIGINS=

# Exact proxy IPs or CIDRs, comma-separated. Empty means trust no forwarded headers.
TRUSTED_PROXIES=

# Optional same-site VNC relay (PHP CLI, behind the site's WS reverse proxy).
CONSOLE_LISTEN=127.0.0.1:18213
# Exact browser origins, including scheme and port. Empty disables authorization.
CONSOLE_ORIGINS=
# Approved upstream WS endpoints as exact lowercase host:port; production requires WSS/public IP.
CONSOLE_TARGETS=
# Multiple isolated environments must set distinct writable PID paths.
# CONSOLE_PID_FILE=/absolute/private/runtime/console-relay.pid
